{
  "__doc__": [
    "Supplier-specific selector rules.  One array per supplier; first match",
    "wins.  Each rule has a `when` predicate and a `canonical` name.  All",
    "predicate keys are optional AND-combined — a rule fires only when every",
    "key in `when` matches.  See docs/BACKEND_HANDOFF.md § 4 for the full key",
    "list.  Keep the comments-as-notes near each rule so future edits know",
    "which real portal element the rule targets."
  ],

  "hotelbeds": [

    "═══ Home search box ══════════════════════════════════════════════",

    { "when": { "dataQa": "destinationsControl" },
      "canonical": "search.destination_selected",
      "notes": "Home — 'Where are you going?' destination input" },

    { "when": { "formControlName": "init" },
      "canonical": "search.checkin_selected",
      "notes": "Home — check-in date (from)" },

    { "when": { "formControlName": "end" },
      "canonical": "search.checkout_selected",
      "notes": "Home — check-out date (to)" },

    { "when": { "dataQa": "input_distribution_accommodation" },
      "canonical": "search.occupancy_selected",
      "notes": "Home — travellers / rooms distribution" },

    { "when": { "dataQa": "btn_search_stay_themepark" },
      "canonical": "search.submit",
      "notes": "Home — main Search button" },

    "═══ Board-type toggles (home advanced filters) ═════════════════",

    { "when": { "label": "Room only" },
      "canonical": "search.filter_changed",
      "notes": "Board filter: Room only" },
    { "when": { "label": "Breakfast" },
      "canonical": "search.filter_changed",
      "notes": "Board filter: Breakfast" },
    { "when": { "label": "Half Board" },
      "canonical": "search.filter_changed",
      "notes": "Board filter: Half Board" },
    { "when": { "label": "Full Board" },
      "canonical": "search.filter_changed",
      "notes": "Board filter: Full Board" },
    { "when": { "label": "All Inclusive" },
      "canonical": "search.filter_changed",
      "notes": "Board filter: All Inclusive" },

    "═══ Luxury / cancellation checkboxes ═══════════════════════════",

    { "when": { "label": "Luxury Collection" },
      "canonical": "search.filter_changed",
      "notes": "Filter: Luxury Collection checkbox" },
    { "when": { "label": "Free cancellation" },
      "canonical": "search.filter_changed",
      "notes": "Filter: Free cancellation checkbox" },

    "═══ Product tabs (top of search box) ═══════════════════════════",

    { "when": { "dataQa": "HOTEL" },
      "canonical": "search.product_stays",
      "notes": "Product tab: Stays" },
    { "when": { "dataQa": "ACTIVITY" },
      "canonical": "search.product_experiences",
      "notes": "Product tab: Experiences" },
    { "when": { "dataQa": "THEME_PARK" },
      "canonical": "search.product_themeparks",
      "notes": "Product tab: Theme parks" },
    { "when": { "dataQa": "TRANSFER" },
      "canonical": "search.product_transfers",
      "notes": "Product tab: Transfers" },
    { "when": { "dataQa": "CARHIRE" },
      "canonical": "search.product_carhire",
      "notes": "Product tab: Car Rental" },

    "═══ Header navigation ═══════════════════════════════════════════",

    { "when": { "dataQa": "main-nav-header-search" },
      "canonical": "nav.search",
      "notes": "Top nav — Search" },
    { "when": { "dataQa": "main-nav-header-bookings" },
      "canonical": "nav.bookings",
      "notes": "Top nav — Bookings" },
    { "when": { "dataQa": "main-nav-header-quotes" },
      "canonical": "nav.quotes",
      "notes": "Top nav — Quotes" },
    { "when": { "dataQa": "main-nav-header-favorites" },
      "canonical": "nav.favorites",
      "notes": "Top nav — Favorites" },
    { "when": { "dataQa": "main-nav-header-insights" },
      "canonical": "nav.insights",
      "notes": "Top nav — Insights" },
    { "when": { "dataQa": "main-nav-header-support" },
      "canonical": "nav.support",
      "notes": "Top nav — Support" },

    "═══ Icon buttons (right side of header) ════════════════════════",

    { "when": { "ariaLabel": "Account" },
      "canonical": "nav.account",
      "notes": "Top nav — Account icon" },
    { "when": { "dataQa": "setting-icon-menu" },
      "canonical": "nav.settings",
      "notes": "Top nav — Settings icon" },
    { "when": { "ariaLabel": "Notifications" },
      "canonical": "nav.notifications",
      "notes": "Top nav — Notifications icon" },
    { "when": { "ariaLabel": "Cart" },
      "canonical": "nav.cart",
      "notes": "Top nav — Cart icon" },

    "═══ Sign out ═════════════════════════════════════════════════════",

    { "when": { "label": "Log out" },
      "canonical": "auth.signout",
      "notes": "Account panel — Log out link" },

    "═══ Bookings search page ═══════════════════════════════════════",

    { "when": {
        "urlPattern": "/bookings/",
        "placeholder": "Booking number or Itinerary ID"
      },
      "canonical": "booking.search",
      "notes": "Bookings page — booking number / itinerary lookup input" },

    { "when": { "dataQa": "filters-form-btn" },
      "canonical": "search.filter_applied",
      "notes": "Bookings page — Apply filters button" }
  ],

  "bedswithease": [

    "═══ Home search box ═════════════════════════════════════════════",

    { "when": { "ariaLabelledby": "where-to-label" },
      "canonical": "search.destination_selected",
      "notes": "Home — 'Destination or hotel' input" },

    { "when": { "ariaLabelledby": "check-in-date-label" },
      "canonical": "search.checkin_selected",
      "notes": "Home — Check-in date input" },

    { "when": { "ariaLabelledby": "duration-label" },
      "canonical": "search.nights_selected",
      "notes": "Home — Nights selector" },

    { "when": { "ariaLabelledby": "guests-label" },
      "canonical": "search.occupancy_selected",
      "notes": "Home — Guests selector" },

    { "when": { "classContains": "search-panel__find-button" },
      "canonical": "search.submit",
      "notes": "Home — Find button" },

    "═══ Header navigation ═══════════════════════════════════════════",

    { "when": { "href": "/group-enquiry" },
      "canonical": "nav.groups",
      "notes": "Top nav — Groups" },

    { "when": { "href": "/my-bookings" },
      "canonical": "nav.bookings",
      "notes": "Top nav — My Bookings" },

    { "when": { "href": "/logout" },
      "canonical": "auth.signout",
      "notes": "Top nav — Logout" },

    "═══ My Bookings page filters ════════════════════════════════════",

    { "when": {
        "urlPattern": "/my-bookings",
        "classContains": "my-bookings-filter__input"
      },
      "canonical": "booking.search",
      "notes": "My Bookings — Booking reference lookup input" },

    { "when": { "ariaLabel": "Arrival From Date Day"   }, "canonical": "search.arrival_from_filter", "notes": "My Bookings — Arrival From day" },
    { "when": { "ariaLabel": "Arrival From Date Month" }, "canonical": "search.arrival_from_filter", "notes": "My Bookings — Arrival From month" },
    { "when": { "ariaLabel": "Arrival From Date Year"  }, "canonical": "search.arrival_from_filter", "notes": "My Bookings — Arrival From year" },

    { "when": { "ariaLabel": "Arrival To Date Day"     }, "canonical": "search.arrival_to_filter",   "notes": "My Bookings — Arrival To day" },
    { "when": { "ariaLabel": "Arrival To Date Month"   }, "canonical": "search.arrival_to_filter",   "notes": "My Bookings — Arrival To month" },
    { "when": { "ariaLabel": "Arrival To Date Year"    }, "canonical": "search.arrival_to_filter",   "notes": "My Bookings — Arrival To year" },

    { "when": { "ariaLabel": "Booking From Date Day"   }, "canonical": "search.booking_from_filter", "notes": "My Bookings — Booking From day" },
    { "when": { "ariaLabel": "Booking From Date Month" }, "canonical": "search.booking_from_filter", "notes": "My Bookings — Booking From month" },
    { "when": { "ariaLabel": "Booking From Date Year"  }, "canonical": "search.booking_from_filter", "notes": "My Bookings — Booking From year" },

    { "when": { "ariaLabel": "Booking To Date Day"     }, "canonical": "search.booking_to_filter",   "notes": "My Bookings — Booking To day" },
    { "when": { "ariaLabel": "Booking To Date Month"   }, "canonical": "search.booking_to_filter",   "notes": "My Bookings — Booking To month" },
    { "when": { "ariaLabel": "Booking To Date Year"    }, "canonical": "search.booking_to_filter",   "notes": "My Bookings — Booking To year" },

    { "when": {
        "urlPattern": "/my-bookings",
        "classContains": "search-button"
      },
      "canonical": "search.filter_applied",
      "notes": "My Bookings — Search button (apply filters)" }
  ],

  "alturabeds": [

    "═══ Header navigation ═══════════════════════════════════════════",

    { "when": { "elementId": "navbarContent", "label": "Team" },
      "canonical": "nav.team",
      "notes": "Top nav — Team link" },

    { "when": { "elementId": "navbarContent", "label": "About us" },
      "canonical": "nav.about",
      "notes": "Top nav — About us link" },

    { "when": { "label": "Contact", "href": "/en/contact" },
      "canonical": "nav.contact",
      "notes": "Top nav — Contact link" },

    { "when": { "label": "Bookings", "href": "/my-bookings" },
      "canonical": "nav.bookings",
      "notes": "Top nav — Bookings link" },

    { "when": { "elementId": "languageDropdown" },
      "canonical": "nav.language",
      "notes": "Top nav — Language selector dropdown" },

    { "when": { "elementId": "userDropdown" },
      "canonical": "nav.account",
      "notes": "Top nav — User / account dropdown" },

    "═══ Home — Product tabs ═════════════════════════════════════════",

    { "when": { "elementId": "pills-hotels-tab" },
      "canonical": "search.product_hotels",
      "notes": "Home — Hotels product tab" },

    { "when": { "elementId": "pills-transfers-tab" },
      "canonical": "search.product_transfers",
      "notes": "Home — Transfers product tab" },

    "═══ Home — Search form ══════════════════════════════════════════",

    { "when": { "elementId": "destination-name" },
      "canonical": "search.destination_selected",
      "notes": "Home — 'Hotel or destination' input" },

    { "when": { "elementId": "stay-dates" },
      "canonical": "search.dates_selected",
      "notes": "Home — Check-in / Check-out date picker" },

    { "when": { "elementId": "guests-input-options" },
      "canonical": "search.occupancy_selected",
      "notes": "Home — Guests input" },

    { "when": { "elementId": "nationality" },
      "canonical": "search.nationality_selected",
      "notes": "Home — Nationality selector" },

    { "when": { "elementId": "select2-nationality-container" },
      "canonical": "search.nationality_selected",
      "notes": "Home — Nationality display container (Select2 widget)" },

    { "when": { "elementId": "currency" },
      "canonical": "search.currency_selected",
      "notes": "Home — Currency selector" },

    { "when": { "elementId": "select2-currency-container" },
      "canonical": "search.currency_selected",
      "notes": "Home — Currency display container (Select2 widget)" },

    { "when": { "classContains": "optional-filters-ctn", "label": "button" },
      "canonical": "search.filter_changed",
      "notes": "Home — Advanced optional filters toggle" },

    { "when": { "urlPattern": "/en/home", "label": "Search" },
      "canonical": "search.submit",
      "notes": "Home — main Search button" },

    "═══ Home — Destination carousel ═════════════════════════════════",

    { "when": { "classContains": "destination-carousel" },
      "canonical": "search.destination_carousel_clicked",
      "notes": "Home — Featured destination carousel link" },

    "═══ My Bookings — Sub-navigation tabs ═══════════════════════════",

    { "when": { "elementId": "showAloBooks" },
      "canonical": "nav.accommodations_tab",
      "notes": "My Bookings — Accommodations tab" },

    { "when": { "elementId": "showTraBooks" },
      "canonical": "nav.transfers_tab",
      "notes": "My Bookings — Transfers tab" },

    "═══ My Bookings — Booking inquiries header ══════════════════════",

    { "when": { "elementId": "booking_id", "classContains": "booking_header_wrapper" },
      "canonical": "booking.inquiries",
      "notes": "My Bookings — Booking inquiries link (top header)" },

    { "when": { "classContains": "booking_header_right", "urlPattern": "/my-bookings" },
      "canonical": "booking.inquiries",
      "notes": "My Bookings — Booking inquiries link (header right)" },

    "═══ My Bookings — Filters ═══════════════════════════════════════",

    { "when": { "elementId": "reference" },
      "canonical": "booking.search",
      "notes": "My Bookings — Booking reference input" },

    { "when": { "elementId": "dateRangePicker" },
      "canonical": "search.date_range_filter",
      "notes": "My Bookings — Date range picker" },

    { "when": { "elementId": "filter-name" },
      "canonical": "search.name_filter",
      "notes": "My Bookings — Agent name filter" },

    { "when": { "elementId": "filter-hotel" },
      "canonical": "search.hotel_filter",
      "notes": "My Bookings — Hotel typeahead filter (container)" },

    { "when": { "elementId": "filter-hotel-name" },
      "canonical": "search.hotel_filter",
      "notes": "My Bookings — Hotel name filter input" },

    { "when": { "elementId": "cleanFilterInputs" },
      "canonical": "search.filter_cleared",
      "notes": "My Bookings — Clear all filters link" },

    { "when": { "elementId": "applyFilters" },
      "canonical": "search.filter_applied",
      "notes": "My Bookings — Search / Apply filters button" },

    "═══ My Bookings — Booking table ═════════════════════════════════",

    { "when": {
        "elementId": "hotel-booking-table",
        "classContains": "d-md-table-cell"
      },
      "canonical": "booking.property_selected",
      "notes": "My Bookings — Hotel name link in booking table row" },

    { "when": {
        "elementId": "hotel-booking-table",
        "classContains": "td_arrow"
      },
      "canonical": "booking.view",
      "notes": "My Bookings — Booking row expand/view arrow button" },

    "═══ My Bookings — Pagination ════════════════════════════════════",

    { "when": { "elementId": "search_pagination" },
      "canonical": "nav.pagination",
      "notes": "My Bookings — Booking list pagination" },

    "═══ My Bookings — PDF export ════════════════════════════════════",

    { "when": { "elementId": "info-header", "label": "PDF" },
      "canonical": "export.pdf",
      "notes": "My Bookings — PDF download button (header)" },

    "═══ My Bookings — Booking inquiry form ══════════════════════════",

    { "when": { "elementId": "con_res", "label": "New booking inquiry" },
      "canonical": "booking.inquiry_new",
      "notes": "My Bookings — New booking inquiry tab" },

    { "when": { "elementId": "con_res", "label": "Inquiries history" },
      "canonical": "booking.inquiry_history",
      "notes": "My Bookings — Inquiries history tab" },

    { "when": { "elementId": "consult_subject" },
      "canonical": "booking.inquiry_subject",
      "notes": "My Bookings — Inquiry subject dropdown" },

    { "when": { "elementId": "consult_msg" },
      "canonical": "booking.inquiry_message",
      "notes": "My Bookings — Inquiry message textarea" },

    { "when": { "elementId": "bookingForm", "label": "Send" },
      "canonical": "booking.inquiry_submitted",
      "notes": "My Bookings — Booking inquiry Send button" },

    "═══ Contact page — Form ═════════════════════════════════════════",

    { "when": { "elementId": "message_type" },
      "canonical": "contact.message_type",
      "notes": "Contact — Message type dropdown" },

    { "when": { "elementId": "message" },
      "canonical": "contact.message",
      "notes": "Contact — Message textarea" },

    { "when": { "elementId": "reload" },
      "canonical": "contact.captcha_refresh",
      "notes": "Contact — Reload CAPTCHA button" },

    { "when": { "elementId": "captcha" },
      "canonical": "contact.captcha_input",
      "notes": "Contact — CAPTCHA input field" },

    { "when": { "urlPattern": "/en/contact", "label": "Submit" },
      "canonical": "contact.submitted",
      "notes": "Contact — Submit contact form button" },

    "═══ Footer — Legal links ════════════════════════════════════════",

    { "when": { "label": "Privacy Policy" },
      "canonical": "nav.privacy_policy",
      "notes": "Footer — Privacy Policy link" },

    { "when": { "label": "Terms of service" },
      "canonical": "nav.terms_of_service",
      "notes": "Footer — Terms of Service link" },

    { "when": { "label": "Legal Notice" },
      "canonical": "nav.legal_notice",
      "notes": "Footer — Legal Notice link" }
  ]
}
