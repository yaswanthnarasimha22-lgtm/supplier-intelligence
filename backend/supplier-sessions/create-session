// ---------------------------------------------------------------------------
// Credential resolution — by supplier key, from env vars
// ---------------------------------------------------------------------------

function getCredentialEnvVars(supplierKey) {
  const envKey = supplierKey.toUpperCase();
  return {
    username: process.env[`${envKey}_USERNAME`],
    password: process.env[`${envKey}_PASSWORD`]
  };
}

// ---------------------------------------------------------------------------
// Session store — in-memory index + one JSON file per session.
//
// Everything (session metadata + its action stream) lives in
//   backend/session-data/sessions/<sessionId>.json
//
// There are no other folders by design: no per-agent, per-day or per-
// supplier shards.  The one-file-per-session layout keeps every record
// atomically rewriteable, trivially greppable, and 1:1 with the
// `supplier_sessions` row the schema migration maps to.
// ---------------------------------------------------------------------------

const sessionsById = new Map();        // session (auth + launch bookkeeping)
const sessionRecordsById = new Map();  // record  (persisted shape, kept hot)

const sessionsDirectory = fileURLToPath(
  new URL("../session-data/sessions/", import.meta.url)
);

function sessionFilePath(sessionId) {
  return `${sessionsDirectory}${sessionId}.json`;
}

// ---------------------------------------------------------------------------
// Serialized atomic writes.
//
// The previous implementation called writeFile() directly on every event.
// Two risks it carried:
//   1. Two concurrent events on the same session could interleave their
//      full-file rewrites and leave the JSON partially overwritten.
//   2. A crash mid-write would truncate the file.
//
// This queue chains writes per sessionId so they run one-at-a-time, and
// each write goes through a tmp file + rename so an aborted write never
// clobbers the previous good copy.  rename() is atomic on POSIX for the
// same filesystem.
// ---------------------------------------------------------------------------

const writeQueueBySessionId = new Map();

async function performAtomicWrite(record) {
  await mkdir(sessionsDirectory, { recursive: true });
  const finalPath = sessionFilePath(record.sessionId);
  const tmpPath = `${finalPath}.tmp-${process.pid}`;
  const payload = projectSessionToDisk(record);
  await writeFile(tmpPath, `${JSON.stringify(payload, null, 2)}\n`);
  await rename(tmpPath, finalPath);
}

function enqueueSessionWrite(record) {
  const prev = writeQueueBySessionId.get(record.sessionId) || Promise.resolve();
  const next = prev
    .catch(() => {})           // never let one failure poison the chain
    .then(() => performAtomicWrite(record));
  writeQueueBySessionId.set(record.sessionId, next);
  // Clean the map entry once the chain tail resolves so idle sessions
  // don't retain their promise forever.
  next.finally(() => {
    if (writeQueueBySessionId.get(record.sessionId) === next) {
      writeQueueBySessionId.delete(record.sessionId);
    }
  });
  return next;
}

// ---------------------------------------------------------------------------
// On-disk projection — turn the hot in-memory record (which keeps the
// internal slim event stream to feed the existing APIs) into the clear,
// DB-ready, incident-reviewable shape the user asked for.
//
// Grouping choices:
//   session.*   stable identity + supplier wiring the DB primary row needs
//   agent.*     who did it (joined from Cognito at session-create time)
//   timings.*   when it happened — ready for started_at / ended_at columns
//   summary.*   derived counters so an on-call engineer can scan one page
//   actions[]   the audit trail itself, newest field order matches the
//               question an incident responder actually asks: when, what,
//               where (url), what element, and why we classified it that way
// ---------------------------------------------------------------------------

const SCHEMA_VERSION = 2;

// Element-identifying fields pulled from metadata into a dedicated
// `target` block so an incident reader does not have to scroll the whole
// metadata blob to see which button was clicked.
const TARGET_FIELDS = [
  "element",
  "elementId",
  "elementName",
  "role",
  "label",
  "href",
  "formName",
  "placeholder",
  "ariaLabel",
  "ariaLabelledby",
  "formControlName",
  "classAttr",
  "dataQa",
  "dataTestid",
  "dataTest",
  "dataCy",
  "dataAnalyticsId"
];

function projectEventToAction(slim) {
  const metadata = slim.metadata || {};
  const target = {};
  const details = {};
  for (const [k, v] of Object.entries(metadata)) {
    if (v === null || v === undefined || v === "") continue;
    if (TARGET_FIELDS.includes(k)) target[k] = v;
    else details[k] = v;
  }
  // The click handler emits elementId/elementName as top-level event
  // fields (not inside metadata).  Lift them into target too so every
  // click action is self-contained.
  if (slim.elementId && !target.elementId) target.elementId = slim.elementId;
  if (slim.elementName && !target.elementName) target.elementName = slim.elementName;
  if (slim.href && !target.href) target.href = slim.href;

  return {
    at: slim.occurredAt || null,
    receivedAt: slim.receivedAt || null,
    eventId: slim.eventId || null,
    type: slim.eventType || null,
    action: slim.action || null,
    canonical: slim.canonicalAction || null,
    url: slim.url || null,
    pageTitle: slim.pageTitle || null,
    tabId: slim.tabId || null,
    ...(Object.keys(target).length ? { target } : {}),
    ...(Object.keys(details).length ? { details } : {})
  };
}

function summarize(record) {
  const counts = Object.create(null);
  let firstUrl = null;
  let lastUrl = null;
  for (const e of record.events) {
    const key = e.canonicalAction || "(unclassified)";
    counts[key] = (counts[key] || 0) + 1;
    if (!firstUrl && e.url) firstUrl = e.url;
    if (e.url) lastUrl = e.url;
  }
  return {
    eventCount: record.events.length,
    canonicalCounts: counts,
    firstUrl,
    lastUrl
  };
}

function projectSessionToDisk(record) {
  const createdAt = record.createdAt || null;
  const endedAt = record.endedAt || null;
  const durationMs =
    createdAt && endedAt
      ? Math.max(0, new Date(endedAt).getTime() - new Date(createdAt).getTime())
      : null;

  return {
    schemaVersion: SCHEMA_VERSION,
    sessionId: record.sessionId,
    supplier: {
      key: record.supplier,
      label: record.supplierLabel,
      startUrl: record.startUrl
    },
    agent: record.agent,
    client: record.client,
    timings: {
      createdAt,
      endedAt,
      durationMs
    },
    summary: summarize(record),
    actions: record.events.map(projectEventToAction)
  };
}

// ---------------------------------------------------------------------------
// API
// ---------------------------------------------------------------------------

function normalizeAgent(rawAgent) {
  if (!rawAgent || typeof rawAgent !== "object") return null;
  const username = String(rawAgent.username || rawAgent.userId || "").trim();
  if (!username) return null;
  return {
    userId: username,
    username,
    displayName: String(rawAgent.displayName || username),
    email: rawAgent.email ? String(rawAgent.email) : null,
    sub: rawAgent.sub ? String(rawAgent.sub) : null,
    provider: rawAgent.provider ? String(rawAgent.provider) : "unknown",
    signedInAt: rawAgent.signedInAt || null
  };
}

export async function createSession(payload) {
  // Accept both "supplier" and "account" for backward compatibility.
  const key = String(payload?.account || payload?.supplier || "").toLowerCase();

  if (!key) {
    return { error: "Missing supplier identifier.", status: 400 };
  }

  const configuration = SUPPLIERS[key];

  if (!configuration) {
    return { error: "Supplier is not approved for launch.", status: 400 };
  }

  const agent = normalizeAgent(payload?.agent);
  // Kept only for in-memory lookups and legacy consumers; NOT persisted on
  // the session record — the record carries `agent` as the single source
  // of truth for identity.
  const userId = agent?.username || payload?.userId || "demo-agent";

  const session = {
    sessionId: `sup_sess_${randomUUID()}`,
    supplier: key,
    supplierLabel: configuration.label,
    startUrl: configuration.startUrl,
    userId,          // in-memory only
    agent,
    launchToken: randomUUID()
  };

  sessionsById.set(session.sessionId, session);

  // In-memory record shape (NOT what is persisted — see projectSessionToDisk).
  // We keep `events` as a flat slim array here because the server's own
  // read APIs (findSessionsByAgent / findEventsByAgent) and the live
  // event-tail iterate it directly.  Projection into the readable disk
  // shape happens only at write time.
  const record = {
    sessionId: session.sessionId,
    supplier: session.supplier,
    supplierLabel: session.supplierLabel,
    startUrl: session.startUrl,
    agent,
    client: payload?.client || null,
    createdAt: new Date().toISOString(),
    endedAt: null,
    eventCount: 0,
    events: []
  };

  sessionRecordsById.set(session.sessionId, record);
  await enqueueSessionWrite(record);

  return {
    status: 201,
    body: {
      sessionId: session.sessionId,
      supplier: session.supplier,
      supplierLabel: session.supplierLabel,
      startUrl: session.startUrl,
      userId,
      agent,
      launchToken: session.launchToken,
      startedAt: record.createdAt
    }
  };
}

export function getSessionCredentials(sessionId, authorization) {
  const session = sessionsById.get(sessionId);

  if (!session || authorization !== `Bearer ${session.launchToken}`) {
    return { error: "Invalid supplier session.", status: 401 };
  }

  const credentials = getCredentialEnvVars(session.supplier);

  if (
    !credentials.username ||
    !credentials.password ||
    credentials.username.trim() === "" ||
    credentials.password.trim() === ""
  ) {
    return {
      error: `No local credentials configured for ${session.supplier}. Check .env file.`,
      status: 409
    };
  }

  return {
    status: 200,
    body: {
      username: credentials.username,
      password: credentials.password,
      autoSubmit: process.env.AUTO_SUBMIT_LOGIN === "true"
    }
  };
}

export async function appendSessionEvent(event, authorization) {
  const session = sessionsById.get(event.sessionId);
  const record = sessionRecordsById.get(event.sessionId);

  if (!session || !record || authorization !== `Bearer ${session.launchToken}`) {
    return { error: "Invalid supplier session.", status: 401 };
  }

  // Events are stored slim — agent identity and supplierLabel live once on
  // the session record and are joined at read time (or hydrated at Elastic
  // ingest).  We strip any client-supplied identity fields here to make
  // sure a compromised extension cannot forge them.
  const meta = event.metadata || {};

  // Prefer the semantic action the extension computed (e.g. "click:book_now");
  // fall back to the eventType itself (e.g. "page.loaded", "login.submitted")
  // so every event in the file carries a human-readable `action` string —
  // never null, never missing.
  const action = event.action || meta.action || event.eventType || "unknown";

  // IMPORTANT: pass the full event to classifyEvent.  The classifier's
  // Layer 1 (selector-rules.json) reads `metadata`, `url`, `pageTitle`,
  // and `eventType`; passing only {action, supplier, role, field} meant
  // every supplier-specific selector rule silently never matched and
  // every click fell through to the generic Layer 2 regexes.  Keep every
  // key the rule DSL inspects wired through here.
  const canonicalAction = classifyEvent({
    action,
    supplier: record.supplier,
    eventType: event.eventType,
    url: event.url,
    pageTitle: event.pageTitle,
    role: meta.role,
    field: meta.field,
    metadata: meta
  });

  const slimEvent = {
    eventId:    event.eventId,
    sessionId:  event.sessionId,
    supplier:   record.supplier,
    eventType:  event.eventType,
    action,             // auto-derived label from the extension
    canonicalAction,    // rule-matched canonical, or null
    occurredAt: event.occurredAt,
    receivedAt: event.receivedAt,
    url:        event.url || null,
    pageTitle:  event.pageTitle || null,
    tabId:      event.tabId || null,
    metadata:   meta
  };

  record.events.push(slimEvent);
  record.eventCount = record.events.length;
  if (slimEvent.eventType === "session.tab_closed") {
    record.endedAt = slimEvent.occurredAt || new Date().toISOString();
  }

  // Serialize per-session writes so concurrent events never interleave
  // their rewrites.  We don't await the queue here — the extension
  // already treats 202 as fire-and-forget — but a failed write surfaces
  // on the chain's `.catch` in enqueueSessionWrite().
  enqueueSessionWrite(record);

  // Return the slim event so the caller (ingest-event) can echo it back
  // to the UI event log; the launcher looks up agent info by sessionId
  // only when it needs to display it.
  return { status: 202, body: { accepted: true, event: slimEvent } };
}

// Read-only helpers useful for the future reporting API.  A backend team can
// swap the implementation for a DB query without changing the callers.
/**
 * Look up the agent's username for a session — used by the ingest-event
 * `agent=` filter so that events can stay slim (no per-event userId).
 * Returns null when the session is unknown to this process.
 */
export function getSessionAgentUsername(sessionId) {
  return sessionRecordsById.get(sessionId)?.agent?.username || null;
}

export function findSessionsByAgent(username) {
  const target = String(username || "").toLowerCase();
  const rows = [];
  for (const record of sessionRecordsById.values()) {
    const rowUsername = String(record.agent?.username || "").toLowerCase();
    if (rowUsername === target) rows.push(record);
  }
  return rows.sort((a, b) => (b.createdAt || "").localeCompare(a.createdAt || ""));
}

/**
 * Return slim events for one agent, ordered newest-first.  Because events
 * are stored without embedded identity, we hydrate on the way out for API
 * callers by attaching the parent session's agent as a sibling field.
 * (The stored file remains slim; only this API projection is hydrated.)
 */
export function findEventsByAgent(username, limit = 500) {
  const target = String(username || "").toLowerCase();
  const events = [];
  for (const record of sessionRecordsById.values()) {
    const rowUsername = String(record.agent?.username || "").toLowerCase();
    if (rowUsername !== target) continue;
    for (const event of record.events) {
      events.push({ ...event, agent: record.agent, supplierLabel: record.supplierLabel });
    }
    if (events.length >= limit * 2) break;
  }
  return events
    .sort((a, b) => (b.occurredAt || "").localeCompare(a.occurredAt || ""))
    .slice(0, limit);
}

// Exported for tests: the pure projection function, so a harness can
// render a session file without touching disk.
export const __test__ = { projectSessionToDisk, projectEventToAction, summarize };
