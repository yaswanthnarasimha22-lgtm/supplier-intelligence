// ---------------------------------------------------------------------------
// Credential resolution — by supplier key, from env vars
// ---------------------------------------------------------------------------

function getCredentialEnvVars(supplierKey) {
  const envKey = supplierKey.toUpperCase();
  return {
    username: process.env[`${envKey}_USERNAME`],
    password: process.env[`${envKey}_PASSWORD`]
  };
}

// ---------------------------------------------------------------------------
// Session store
// ---------------------------------------------------------------------------

const sessionsById = new Map();
const sessionRecordsById = new Map();
const sessionDataDirectory = fileURLToPath(
  new URL("../session-data/", import.meta.url)
);

function sessionFilePath(sessionId) {
  return `${sessionDataDirectory}${sessionId}.json`;
}

async function saveSessionRecord(record) {
  await mkdir(sessionDataDirectory, { recursive: true });
  await writeFile(
    sessionFilePath(record.sessionId),
    `${JSON.stringify(record, null, 2)}\n`
  );
}

// ---------------------------------------------------------------------------
// API
// ---------------------------------------------------------------------------

export async function createSession(payload) {
  // Accept both "supplier" and "account" for backward compatibility.
  // The web app sends { supplier: "hotelbeds" }.
  const key = String(payload?.account || payload?.supplier || "").toLowerCase();

  if (!key) {
    return { error: "Missing supplier identifier.", status: 400 };
  }

  const configuration = SUPPLIERS[key];

  if (!configuration) {
    return { error: "Supplier is not approved for launch.", status: 400 };
  }

  const session = {
    sessionId: `sup_sess_${randomUUID()}`,
    supplier: key,
    supplierLabel: configuration.label,
    startUrl: configuration.startUrl,
    userId: payload?.userId || "demo-agent",
    launchToken: randomUUID()
  };

  sessionsById.set(session.sessionId, session);

  const record = {
    sessionId: session.sessionId,
    supplier: session.supplier,
    supplierLabel: session.supplierLabel,
    startUrl: session.startUrl,
    userId: session.userId,
    createdAt: new Date().toISOString(),
    events: []
  };

  sessionRecordsById.set(session.sessionId, record);
  await saveSessionRecord(record);

  return { status: 201, body: session };
}

export function getSessionCredentials(sessionId, authorization) {
  const session = sessionsById.get(sessionId);

  if (!session || authorization !== `Bearer ${session.launchToken}`) {
    return { error: "Invalid supplier session.", status: 401 };
  }

  const credentials = getCredentialEnvVars(session.supplier);

  if (
    !credentials.username ||
    !credentials.password ||
    credentials.username.trim() === "" ||
    credentials.password.trim() === ""
  ) {
    return {
      error: `No local credentials configured for ${session.supplier}. Check .env file.`,
      status: 409
    };
  }

  return {
    status: 200,
    body: {
      username: credentials.username,
      password: credentials.password,
      autoSubmit: process.env.AUTO_SUBMIT_LOGIN === "true"
    }
  };
}

export async function appendSessionEvent(event, authorization) {
  const session = sessionsById.get(event.sessionId);
  const record = sessionRecordsById.get(event.sessionId);

  if (!session || !record || authorization !== `Bearer ${session.launchToken}`) {
    return { error: "Invalid supplier session.", status: 401 };
  }

  record.events.push(event);
  await saveSessionRecord(record);
  return { status: 202, body: { accepted: true } };
}
