# ---------------------------------------------------------------------------
# AWS Cognito — shared User Pool used for agent sign-in.
# These identifiers are public (they identify the pool/client, not credentials)
# and are also embedded in web-app/src/services/auth.js.  Keep them here in
# sync with the deployed pool.  The static / demo agent accounts in auth.js
# continue to work alongside Cognito for local development.
# ---------------------------------------------------------------------------
AWS_REGION=eu-west-1
USER_POOL_ID=eu-west-1_1yghGdnkD
APP_CLIENT_ID=5e80b7ijtpsgfgt4sjnktakmqr
COGNITO_DOMAIN=https://dynamic-tt-uat.auth.eu-west-1.amazoncognito.com
JWKS_URL=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_jkKnSFsS1/.well-known/jwks.json
